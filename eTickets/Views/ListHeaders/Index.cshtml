@model IEnumerable<ListHeader>

@{
    ViewData["Title"] = "Lists";
}

<div>
    <div class="col-md-8 offset-md-2">
        <table class="table">
            <thead>
                <tr class="text-center">
                    <th>@Html.DisplayNameFor(list => list.Name)</th>
                    <th>@Html.DisplayNameFor(list => list.Description)</th>
                    <th>@Html.DisplayNameFor(list => list.ItemStatus)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var list in Model)
                {
                    <tr>
                        <td class="align-middle">
                            @Html.DisplayFor(modelItem => list.Name)
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(modelItem => list.Description)
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(modelItem => list.ItemStatus)
                        </td>
                        <td class="align-middle">
                            <a class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i>Edit</a> |
                            <a class="btn btn-outline-info"><i class="bi bi-eye"></i>Details</a> |
                            <a class="btn btn-danger text-white"><i class="bi bi-trash"></i>Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>