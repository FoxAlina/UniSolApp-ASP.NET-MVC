@model Module

@{
    ViewData["Title"] = "Create Module";
}

<div class="row text">
    <div class="col-md-8 offset-2">
        <p>
            <h1>@Model.Name</h1>
        </p>
        <div class="row">
            <div class="col-md-8 offset-2">
                    <div class="form-group text-center">
                        <img class="border-info rounded" style="max-width:150px" id="ProfilePictureURLPreview" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ProfilePictureURL" class="col-form-label"></label>
                        <input asp-for="ProfilePictureURL" class="form-control" readonly/>
                        <span asp-validation-for="ProfilePictureURL" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Name" class="col-form-label"></label>
                        <input asp-for="Name" class="form-control" readonly/>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="col-form-label"></label>
                        <input asp-for="Description" class="form-control" readonly/>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <a class="btn btn-danger text-white float-end mt-1" asp-action="Delete" asp-route-id="@Model.Id">
                            <i class="bi bi-trash"></i>Delete
                        </a>
                        <a class="btn btn-outline-success float-end me-1 mt-1" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="bi bi-pencil-square"></i>Edit
                        </a>
                        <a class="btn btn-outline-secondary float-start mt-1" asp-action="Index">Show all</a>
                    </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            var output = document.getElementById('ProfilePictureURLPreview');
            output.src = $("#ProfilePictureURL").val();
        })
    </script>
}