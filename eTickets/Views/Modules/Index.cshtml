@model IEnumerable<Module>

@{
    ViewData["Title"] = "Modules";
}

<div class="col-md-8 offset-md-2">
    <table class="table">
        <thead>
            <tr class="text-center">
                <th>@Html.DisplayNameFor(module => module.ProfilePictureURL)</th>
                <th>@Html.DisplayNameFor(module => module.Name)</th>
                <th>@Html.DisplayNameFor(module => module.Description)</th>
                <th>@Html.DisplayNameFor(module => module.ItemStatus)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var module in Model)
            {
            <tr>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => module.ProfilePictureURL)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => module.Name)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => module.Description)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => module.ItemStatus)
                </td>
                <td class="align-middle">
                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@module.Id"><i class="bi bi-pencil-square"></i>Edit</a> |
                    <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@module.Id"><i class="bi bi-eye"></i>Details</a> |
                    <a class="btn btn-danger text-white" asp-action="Delete" asp-route-id="@module.Id"><i class="bi bi-trash"></i>Delete</a>
                </td>
            </tr>
            }
        </tbody>
        <tr>
            <td></td>
        </tr>
    </table>
</div>

@foreach (var item in Model)
{
    <div class="col-md-4 col-xs-6 border-primary mb-3">
        <div class="card mb-3" style="max-width: 540px;">
            <div class="row g-0">
                <div class="col-md-12">
                    <div class="card-header text-white bg-info">
                        <p class="card-text">
                            <h5 class="card-title">
                                @item.Name
                                <a class="text-white float-right" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i></a>
                            </h5>
                        </p>
                    </div>
                </div>
                    
                <div class="col-md-6">
                    <div class="card-body">
                        <p class="card-text">@item.Description</p>
                        <p class="card-text">@item.CreatedDateTime.ToString("dd.MM.yyyy")</p>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="card-footer ">
                        <p class="card-text">
                            <a class="btn btn-outline-primary float-right" asp-action="Details" asp-route-id="@item.Id">
                                <i class="bi bi-eye-fill"></i> Show Details
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<div style="position:fixed; right:25px; bottom:25px;" class="text-white">
    <a asp-controller="Modules" asp-action="Create" class="btn btn-success"> 
    <i class="bi bi-plus-circle"></i> Add new </a>
</div>