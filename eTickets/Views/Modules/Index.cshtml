@model IEnumerable<Module>

@{
    ViewData["Title"] = "Modules";
}

<div class="col-md-8 offset-md-2">
    <table class="table">
        <thead>
            <tr class="text-center">
                <th>@Html.DisplayNameFor(module => module.ProfilePictureURL)</th>
                <th>@Html.DisplayNameFor(module => module.Name)</th>
                <th>@Html.DisplayNameFor(module => module.Description)</th>
                <th>@Html.DisplayNameFor(module => module.ItemStatus)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var module in Model)
            {
                <tr class="text-center">
                    <td class="align-middle">
                        <img class="border-info rounded" src="@module.ProfilePictureURL" alt="@module.Name" style="max-height:200px; max-width:150px" />
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => module.Name)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => module.Description)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => module.ItemStatus)
                    </td>
                    <td class="align-middle">
                        <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@module.Id"><i class="bi bi-eye"></i>Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 border-primary mb-2">
            <div class="card mb-2" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-md-12">
                        <div class="card-header text-white bg-info">
                            <p class="card-text">
                                <h5 class="card-title">
                                    <a class="text-white float-right" asp-action="Details" asp-route-id="@item.Id" style="text-decoration-line: none">@item.Name</a>
                                </h5>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <img class="border-info rounded" src="@item.ProfilePictureURL" alt="@item.Name" style="max-height:150px; max-width:150px" />
                    </div>
                    <div class="col-md-6">
                        <div class="card-body">

                            <p class="card-text">@item.Description</p>
                            <p class="card-text">@item.CreatedDateTime.ToString("dd.MM.yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<div style="position:fixed; right:25px; bottom:25px;" class="text-white">
    <a asp-controller="Modules" asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add new
    </a>
</div>